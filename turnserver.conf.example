# coturn TURN server config for ManaMesh.
# Copy to turnserver.conf (gitignored - contains a secret), fill in
# YOUR_SERVER_PUBLIC_IP, your-domain.example and a real password below,
# then use the SAME user/password in frontend/webrtc-manager.js's iceServers list.

listening-port=3478
tls-listening-port=5349
min-port=49152
max-port=65535

# Your Hetzner server's public IPv4 (found in the Hetzner Cloud console)
external-ip=YOUR_SERVER_PUBLIC_IP

fingerprint
lt-cred-mech
user=manamesh:CHANGE_ME_PASSWORD
realm=your-domain.example

# No Hetzner private network is in use here, so there's no internal LAN to protect
# with denied-peer-ip - and blocking those ranges also blocks legitimate ICE candidate
# pairs to clients on carrier CGNAT (10.x) or home Wi-Fi (192.168.x), which was denying
# real player connections. If a private network is added later, revisit this.
no-multicast-peerelay

no-cli
