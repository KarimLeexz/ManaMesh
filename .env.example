# Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Card index (built with: python backend/build_index.py)
CARD_INDEX_PATH=card_index.npz

# Match threshold: max Hamming distance (out of 256) for a scan to count as a match.
# Lower = stricter (fewer wrong cards, more "not recognized"). 78 was measured on the full index.
MAX_HASH_DISTANCE=78

# Debugging: save every scan (image, click position, result) into this folder, to study real-world
# failures. Leave empty to save nothing.
SAVE_SCANS_DIR=

# Video server (LiveKit). For local development run `livekit-server --dev` (key devkey,
# secret "secret") and keep these values. In production (docker-compose) set your own key and
# a long random secret, and leave LIVEKIT_URL empty: the browser then uses <your domain>/livekit.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
