# Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Card index (built with: python backend/build_index.py)
CARD_INDEX_PATH=card_index.npz

# Match threshold: max Hamming distance (out of 256) for a scan to count as a match.
# Lower = stricter (fewer wrong cards, more "not recognized"). 78 was measured on the full index.
MAX_HASH_DISTANCE=78
